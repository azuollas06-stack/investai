  "stories": [
    {
      "id": "anthropic-ipo",
      "date": "2026-11-18",
      "kind": "ipo",
      "title": "Anthropic šiandien nustato IPO kainą, prekyba – ketvirtadienį",
      "symbols": [
        "NASDAQ:ANT"
      ],
      "lead": "Claude kūrėja Anthropic lapkričio 18 d. vakare (JAV laiku) nustato galutinę akcijų kainą, o lapkričio 19 d. jos turėtų pradėti prekiauti Nasdaq biržoje simboliu ANT. Tai vienas didžiausių IPO istorijoje.",
      "facts": [
        "Kainų intervalas – 70–78 $ už A klasės akciją, siūloma 825 mln. akcijų (iš jų 23,6 mln. parduoda įkūrėjai); žiniasklaida skelbia, kad siekiama kainos intervalo viršuje ar aukščiau.",
        "Kartu IPO kaina 26 mlrd. $ vertės nebalsuojančių akcijų perka Google, Nvidia, AMD, Broadcom, Micron, Microsoft ir TSMC.",
        "Pagal S-1/A, liepos–rugsėjo mėn. pajamos – 17,0 mlrd. $, veiklos nuostolis – 0,57 mlrd. $; grynasis nuostolis (23,3 mlrd. $) daugiausia susidarė dėl 21,9 mlrd. $ nepiniginio apskaitinio mokesčio.",
        "Iki 20 % akcijų skiriama mažmeniniams investuotojams per šešias platformas (Schwab, Fidelity, Robinhood ir kt.), tačiau paskirstymas negarantuojamas.",
        "Valdymas: septyni įkūrėjai per F klasės akciją turi 50,1 % balsų, o daugumą valdybos renka Ilgalaikės naudos patikos fondas (Long-Term Benefit Trust)."
      ],
      "pro": [
        {
          "who": "Investuotojai, jau turintys Anthropic akcijų",
          "text": "Mato didžiulę galimybę: tai pirmoji gryna dirbtinio intelekto bendrovė biržoje, leidžianti mažmeniniams investuotojams dalyvauti DI augime ne tik per lustų gamintojus.",
          "source": "CNBC"
        },
        {
          "who": "Rinkos analitikai (MarketPulse)",
          "text": "Kelis kartus viršyta paklausa rodo, kad didieji investuotojai vis dar nori investuoti į DI temą nepaisant aukštų vertinimų.",
          "source": "MarketPulse"
        },
        {
          "who": "S-1 dokumento skaitytojai",
          "text": "Pajamos auga daug sparčiau nei išlaidos skaičiavimams; antrąjį ketvirtį fiksuotas veiklos pelnas.",
          "source": "DeepLearning.AI"
        }
      ],
      "con": [
        {
          "who": "Jay Ritter („Mr. IPO“), IPO tyrėjas",
          "text": "Įėjus į biržą su daugiau nei 1 trln. $ verte, procentinis augimo potencialas investuotojams lieka gerokai mažesnis.",
          "source": "TheStreet"
        },
        {
          "who": "Analitikai, kalbinti „Fortune“",
          "text": "Vertė, viršijanti ~40 kartų metines pajamas, istoriškai pasiekta tik 14 iš 4 110 JAV IPO nuo 1980 m. – istorija nebūtinai palanki tokioms kainoms.",
          "source": "Fortune"
        },
        {
          "who": "Josh Schafer, Yahoo Finance",
          "text": "Įspėja mažmeninius investuotojus nepirkti pirmą dieną: didelės technologijų emisijos istoriškai neretai smarkiai krito per pirmuosius metus, be to, konkurencija (pvz., OpenAI) didelė.",
          "source": "Fox Business"
        }
      ],
      "disclosure": "InvestAI turinį rengia DI modelis Claude, kurį kuria Anthropic. Todėl čia pateikiami tik šaltinių faktai ir abiejų pusių nuomonės, be jokio savo vertinimo.",
